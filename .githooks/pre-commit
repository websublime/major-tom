#!/bin/sh
# ground-control guard: no commits to the default branch.
# Enable once per clone: git config core.hooksPath .githooks
b="$(git symbolic-ref --short HEAD 2>/dev/null)"
d="$(git config ground-control.defaultBranch || echo main)"
if [ "$b" = "$d" ]; then
  echo "ground-control: direct commits to '$d' are blocked. claim = branch: git switch -c t<id>-<slug>" >&2
  echo "Bypassing this guard (--no-verify, unsetting core.hooksPath, editing .githooks) is a gate violation the Verify gate treats as fraud." >&2
  exit 1
fi
exit 0
